# =============================================================================
# Copy this file to `.env` and fill in your values:   cp .env.example .env
#
# `.env` is git-ignored (it holds your secret key); this example file is safe
# to commit because it contains no real values.
#
# Precedence: a REAL environment variable (e.g. `export ANTHROPIC_API_KEY=...`)
# wins over the same variable in `.env`.
# =============================================================================

# Required. Create a key at https://platform.claude.com (Claude Console).
ANTHROPIC_API_KEY=

# Only needed if your key is NOT scoped to a workspace (the API then answers
# 400 "must include the anthropic-workspace-id header"). Looks like wrkspc_01...
# Find it in the Claude Console under Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# ---- Optional settings (the values shown are the defaults) ------------------

# Which Claude model to call. claude-haiku-4-5 = latest Haiku ($1 / $5 per 1M tokens).
# AGENT_MODEL=claude-haiku-4-5

# Upper limit on tokens the model may WRITE in one response (thinking + answer).
# AGENT_MAX_TOKENS=16000

# Extended thinking: 0 = off. Otherwise a token budget >= 1024 and < AGENT_MAX_TOKENS.
# AGENT_THINKING_BUDGET=0

# How long to wait for the API to answer before giving up (seconds).
# AGENT_TIMEOUT_SECONDS=120

# Where the API lives. Only change this for proxies or testing.
# AGENT_BASE_URL=https://api.anthropic.com

# The ONLY folder the read_file tool may read (default: the project's workspace/ folder).
# AGENT_WORKSPACE_DIR=./workspace
